{
  "name": "control-retiros",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "control-retiros-db",
      "database_id": "PEGA_AQUI_EL_ID_DE_TU_BASE_D1"
    }
  ]
}
